RewriteEngine On
RewriteBase /

# Trailing slash for pretty URLs (skip real files)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
RewriteRule ^(.*)$ https://ratingseo.ru/$1/ [R=301,L,QSA]


# A) /index.html → https://ratingseo.ru/  одним 301 (сразу финальный URL)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://ratingseo.ru/ [R=301,L]

# B) Несколько слэшей — ловим по «сырому» запросу (THE_REQUEST),
#    т.к. Apache часто схлопывает // в REQUEST_URI и отдаёт 200
#    //foo/bar → /foo/bar
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /{2,}([^\s?]*)\ HTTP [NC]
RewriteRule .* https://ratingseo.ru/%1 [R=301,L,NE,QSA]

#    /foo//bar → /foo/bar
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\s?]*?)/{2,}([^\s?]*)\ HTTP [NC]
RewriteRule .* https://ratingseo.ru/%1/%2 [R=301,L,NE,QSA]

#    fallback, если // всё же попал в REQUEST_URI
RewriteCond %{REQUEST_URI} ^(.*)//+(.*)$
RewriteRule .* https://ratingseo.ru%1/%2 [R=301,L,NE,QSA]

# C) http и/или www → https://ratingseo.ru/... одним 301
#    (учитываем X-Forwarded-Proto на прокси Beget)
RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.ratingseo\.ru$ [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?ratingseo\.ru$ [NC]
RewriteRule ^ https://ratingseo.ru%{REQUEST_URI} [R=301,L]

# Политика
RewriteRule ^privacy\.html$ https://ratingseo.ru/privacy/ [R=301,L]
RewriteRule ^privacy/?$ privacy/index.html [L]

# Методология
RewriteRule ^methodology\.html$ https://ratingseo.ru/methodology/ [R=301,L]
RewriteRule ^methodology/?$ methodology/index.html [L]

# О проекте
RewriteRule ^about\.html$ https://ratingseo.ru/about/ [R=301,L]
RewriteRule ^about/?$ about/index.html [L]

# Карточки агентств
RewriteRule ^agency/?$ agency/index.html [L]
RewriteRule ^agency/([a-z0-9-]+)/?$ agency/$1/index.html [L]

# Нишевые рейтинги
RewriteRule ^rating/?$ rating/index.html [L]
RewriteRule ^rating/([a-z0-9-]+)/?$ rating/$1/index.html [L]

# Awards
RewriteRule ^certificates/?$ certificates/index.html [L]
RewriteRule ^certificate/([a-z0-9-]+)/?$ certificate/$1/index.html [L]
